# ==============================================================================
# VGO CINEMA - ACTIVE CONFIGURATION (LOCAL)
# ==============================================================================
# ⚠️  This file is in .gitignore and MUST NOT be committed.
# ⚠️  Never paste real secrets into .env.example, README, or chat.
# ==============================================================================

# --- Infrastructure ---
# Redis is OPTIONAL. ENABLE_REDIS=false disables the Redis adapter
# entirely (no ping attempts, no warning spam) and falls back to a
# per-process LRU + in-memory pub/sub. Recommended for single-container
# deployments and local development.
ENABLE_REDIS=true
REDIS_URL=redis://REPLACE_ME@127.0.0.1:6379/0

# --- Auth + API keys ---
# SECURE BY DEFAULT: AUTH_REQUIRED=true in code. Set false ONLY for local
# development without keys. In production, always keep true.
AUTH_REQUIRED=true
# Comma-separated API key triples: key:label:limit_per_window
# Example: sk-prod:demo:10,sk-test:local:60
API_KEYS=your-api-key-here

# --- CORS ---
# Empty in dev to use the localhost regex; set explicit origins in prod.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:9000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:9000

# --- App ---
LOG_LEVEL=REPLACE_ME
MAX_SCENES_PER_VIDEO=4

# --- NVIDIA NIM (active) ---
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DIRECTOR_MODEL=REPLACE_ME
NVIDIA_COMPOSER_MODEL=REPLACE_ME
NVIDIA_PROMPT_MODEL=REPLACE_ME
NVIDIA_REQUEST_TIMEOUT=300

# --- Image generation (real FLUX.1-dev via NIM Visual GenAI) ---
# Options:
#   flux_dev      — real FLUX.1-dev on NIM (~$0.012/img, 28 steps, cfg 3.5)
#   flux_schnell  — real FLUX.1-schnell on NIM (distilled, 1-4 steps, cfg 0)
#   sd35          — real Stable Diffusion 3.5 Large on NIM
#   picsum        — Lorem Picsum placeholder (no key, no prompt match)
IMAGE_PROVIDER=REPLACE_ME
IMAGE_WIDTH=1280
IMAGE_HEIGHT=768
IMAGE_INFERENCE_STEPS=28
IMAGE_CFG_SCALE=REPLACE_ME
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai

# --- Voice (NVIDIA Magpie TTS via NVCF gRPC, free endpoint) ---
TTS_PROVIDER=REPLACE_ME
TTS_VOICE=REPLACE_ME
TTS_LANGUAGE=REPLACE_ME
TTS_SAMPLE_RATE=44100
TTS_FUNCTION_ID=REPLACE_ME
TTS_NVCF_URI=REPLACE_ME
TTS_MAX_CHARS_PER_SCENE=220

# --- Agnes AI (preferred for chat, image, video) ---
# Set PROVIDER=agnes to switch the entire pipeline to Agnes models.
# H4: Agnes 未配置真实 key（当前为占位符），已从可用链移除；如需启用请在 Agnes 控制台创建真实 key 后替换此处。
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_CHAT_MODEL=REPLACE_ME
AGNES_IMAGE_MODEL=REPLACE_ME
AGNES_VIDEO_MODEL=REPLACE_ME
AGNES_VIDEO_SECONDS=5

# Video generation mode: auto / image2video / text2video
#   auto        — image-to-video when an image is available, text-to-video
#                 otherwise (recommended default)
#   image2video — always pass the generated image as image_url (higher quality)
#   text2video  — always omit image_url; prompt only (no image dependency)
# Can be overridden per-task via the API request body's video_mode field.
VIDEO_MODE=REPLACE_ME

# Provider routing: "agnes" (default) or "nvidia"
# agnes  → Agnes AI for LLM + image + video (TTS stays as Magpie)
# nvidia → NVIDIA NIM for LLM + FLUX image + NVIDIA TTS
PROVIDER=REPLACE_ME

# Optional: comma-separated denylist of terms rejected in prompts.
# Empty (default) = no content filtering. Example:
# BLOCKED_PROMPT_WORDS=term1,term2,term3
MAGIC_HOUR_API_KEY=your-magic-hour-api-key
VIDEO_PROVIDER_PRIMARY=REPLACE_ME
VIDEO_PROVIDER_FALLBACK=REPLACE_ME
MAGIC_HOUR_MODEL=REPLACE_ME
MAGIC_HOUR_RESOLUTION=REPLACE_ME
REDIS_PASSWORD=your-redis-password
OUTPUT_SIGNING_SECRET=your-output-signing-secret
